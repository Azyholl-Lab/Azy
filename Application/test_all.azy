# ============================================================
#  Полный тест языка Azy v0.2
#  Покрывает: лексер, парсер, семантику, интерпретатор
#  Запуск:  AZY_compiler.exe tests\test_all.azy
# ============================================================

# ------------------------------------------------------------
# 1. КОММЕНТАРИИ (все три вида)
# ------------------------------------------------------------
print.ln("--- 1. КОММЕНТАРИИ (все три вида) ---");
# однострочный через решётку
// однострочный через двойной слэш
/* многострочный
   комментарий */

# ------------------------------------------------------------
# 2. ЛИТЕРАЛЫ
# ------------------------------------------------------------
print.ln("--- 2. ЛИТЕРАЛЫ ---");
var i    = 42;
var f    = 3.14;
var f2   = .5;
var s    = "Hello, Azy!";
var t    = true;
var fa   = false;
print.ln(i);    # 42
print.ln(f);    # 3.14
print.ln(f2);   # 0.5
print.ln(s);    # Hello, Azy!
print.ln(t);    # true
print.ln(fa);   # false

# ------------------------------------------------------------
# 3. ПРИСВАИВАНИЯ — все операторы
# ------------------------------------------------------------
print.ln("--- 3. ПРИСВАИВАНИЯ ---");
var a = 10;
a += 5;     # 15
a -= 3;     # 12
a *= 2;     # 24
a /= 4;     # 6
print.ln(a);    # 6

# ------------------------------------------------------------
# 4. АРИФМЕТИКА И ПРИОРИТЕТ
# ------------------------------------------------------------
print.ln("--- 4. АРИФМЕТИКА ---");
var x1 = 2 + 3 * 4;         # 14
var x2 = (2 + 3) * 4;       # 20
var x3 = 10 - 5 - 2;        # 3
var x4 = 20 / 4 / 5;        # 1
var x5 = -5;                # -5
var x6 = -3 * -2 + 10;      # 16
print.ln(x1);   # 14
print.ln(x2);   # 20
print.ln(x3);   # 3
print.ln(x4);   # 1
print.ln(x5);   # -5
print.ln(x6);   # 16

# ------------------------------------------------------------
# 5. ЛОГИКА И СРАВНЕНИЯ
# ------------------------------------------------------------
print.ln("--- 5. ЛОГИКА ---");
print.ln(10 == 10);         # true
print.ln(10 != 5);          # true
print.ln(10 < 100);         # true
print.ln(10 > 1);           # true
print.ln(10 <= 10);         # true
print.ln(10 >= 10);         # true
print.ln(true && false);    # false
print.ln(true || false);    # true
print.ln(!true);            # false
print.ln(not false);        # true
var c11 = (10 > 5) && (3.14 < 10.0) || ("abc" == "x");
print.ln(c11);              # true

# ------------------------------------------------------------
# 6. ПОСТФИКСНЫЕ ++ / --
# ------------------------------------------------------------
print.ln("--- 6. ++/-- ---");
var counter = 0;
counter++;
counter++;
counter++;
print.ln(counter);          # 3
counter--;
print.ln(counter);          # 2
var old = counter++;        # old = 2, counter = 3
print.ln(old);              # 2
print.ln(counter);          # 3

# ------------------------------------------------------------
# 7. IF / ELSE / ELSE IF
# ------------------------------------------------------------
print.ln("--- 7. IF ---");
var msg = "none";
if (a == 6) {
    msg = "a==6";
} else {
    msg = "a!=6";
}
print.ln(msg);              # a==6

var r = "none";
if (a == 1) {
    r = "one";
} else if (a == 2) {
    r = "two";
} else if (a == 6) {
    r = "six";
} else {
    r = "other";
}
print.ln(r);                # six

var big = false;
if (a > 0) {
    if (a > 100) {
        big = true;
    } else {
        big = false;
    }
}
print.ln(big);              # false

# ------------------------------------------------------------
# 8. WHILE
# ------------------------------------------------------------
print.ln("--- 8. WHILE ---");
var i1 = 0;
while (i1 < 5) {
    i1++;
}
print.ln(i1);               # 5

var j = 5;
var sum = 0;
while (j > 0) {
    sum += j;
    j--;
}
print.ln(sum);              # 15

# ------------------------------------------------------------
# 9. DO ... WHILE
# ------------------------------------------------------------
print.ln("--- 9. DO-WHILE ---");
var k = 0;
do {
    k++;
} while (k < 5);
print.ln(k);                # 5

var n = 5;
var fact = 1;
do {
    fact *= n;
    n--;
} while (n > 1);
print.ln(fact);             # 120

# ------------------------------------------------------------
# 10. FOR — ФОРМА 1: for (i == N)
# ------------------------------------------------------------
print.ln("--- 10. FOR form 1 ---");
for (p == 3) {
    print(p);
    print(" ");
}
print.ln("");
# 0 1 2

# ------------------------------------------------------------
# 11. FOR — ФОРМА 2: C-style
#     (Azy-семантика: `==` означает "пока не достигнуто")
# ------------------------------------------------------------
print.ln("--- 11. FOR form 2 ---");
for (q = 0; q == 5; q++) {
    print(q);
    print(" ");
}
print.ln("");
# 0 1 2 3 4

for (r2 = 0; r2 == 10; r2 = r2 + 2) {
    print(r2);
    print(" ");
}
print.ln("");
# 0 2 4 6 8

# ------------------------------------------------------------
# 12. FOR — ФОРМА 3: foreach по строке
# ------------------------------------------------------------
print.ln("--- 12. FOR form 3 (foreach) ---");
var text = "abc";
for (ch in text) {
    print(ch);
    print(" ");
}
print.ln("");
# a b c

# ------------------------------------------------------------
# 13. BREAK / CONTINUE
# ------------------------------------------------------------
print.ln("--- 13. BREAK/CONTINUE ---");
for (b1 = 0; b1 == 10; b1++) {
    if (b1 == 5) {
        break;
    }
    print(b1);
    print(" ");
}
print.ln("");
# 0 1 2 3 4

for (b2 = 0; b2 == 10; b2++) {
    if (b2 == 5) {
        continue;
    }
    print(b2);
    print(" ");
}
print.ln("");
# 0 1 2 3 4 6 7 8 9

# ------------------------------------------------------------
# 14. PRINT / PRINT.LN
# ------------------------------------------------------------
print.ln("--- 14. PRINT ---");
print("без переноса | ");
print.ln("с переносом");
print(42);
print(" | ");
print(3.14);
print(" | ");
print(true);
print.ln("");

# ------------------------------------------------------------
# 15. ВЛОЖЕННЫЕ КОНСТРУКЦИИ
# ------------------------------------------------------------
print.ln("--- 15. ВЛОЖЕННЫЕ ---");
for (i2 = 0; i2 == 3; i2++) {
    for (j2 = 0; j2 == 3; j2++) {
        if (i2 == j2) {
            print("X");
        } else {
            print(".");
        }
    }
    print.ln("");
}
# X..
# .X.
# ..X

# ------------------------------------------------------------
# 16. СЛОЖНЫЕ ВЫРАЖЕНИЯ
# ------------------------------------------------------------
print.ln("--- 16. СЛОЖНЫЕ ВЫРАЖЕНИЯ ---");
var r3 = ((2 + 3) * (4 - 1)) / ((10 / 2) + 1);
print.ln(r3);               # 2 (int-деление 15/6)

# ------------------------------------------------------------
# 17. VAR — множественное, без инициализации
# ------------------------------------------------------------
print.ln("--- 17. VAR ---");
var u1, u2;
u1 = 10;
u2 = 20;
print.ln(u1 + u2);          # 30

var m1 = 1, m2 = 2, m3 = 3;
print.ln(m1 + m2 + m3);     # 6

# ------------------------------------------------------------
# 18. FN / DEF — определение функций
# ------------------------------------------------------------
print.ln("--- 18. FN ---");

fn add(p, q) {
    return p + q;
}

def mul(p, q) {
    return p * q;
}

fn greet(person) {
    print("Hello, ");
    print.ln(person);
}

greet("World");             # Hello, World

# ------------------------------------------------------------
# 19. RETURN + вызовы (рекурсия)
# ------------------------------------------------------------
print.ln("--- 19. RETURN + CALL ---");

fn factorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

print.ln(factorial(5));         # 120
print.ln(add(3, 4));            # 7
print.ln(mul(3, 4));            # 12
print.ln(add(add(1, 2), 3));    # 6

# ------------------------------------------------------------
# 20. BUILTIN: len, str, int, float
# ------------------------------------------------------------
print.ln("--- 20. BUILTIN ---");
print.ln(len("hello"));     # 5
print.ln(len(""));          # 0
print.ln(str(42));          # 42
print.ln(str(3.14));        # 3.14
print.ln(str(true));        # true
print.ln(int("123"));       # 123
print.ln(int(3.99));        # 3
print.ln(float(5));         # 5
print.ln(float("3.14"));    # 3.14
print.ln(int("50") + 10);   # 60

print.ln("=== ВСЁ ПРОЙДЕНО ===");

