var counter = 0;

fn greet(name) {
    print("Hello, ");
    print.ln(name);
}

fn factorial(n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

greet("World");
print("5! = ");
print.ln(factorial(5));

while (counter < 3) {
    print("counter = ");
    print.ln(counter);
    counter++;
}

for (ch in "abc") {
    print(ch);
    print(" ");
}
print.ln("");

var x = 10;
var y = 3;
print("x / y = ");
print.ln(x / y);
print("x / float(y) = ");
print.ln(x / float(y));